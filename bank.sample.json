[{"analysis":"只有符号不同的两数互为相反数。","answer":"B","difficulty":1,"id":"num-01","knowledge":["有理数"],"options":["-3","3","1/3","-1/3"],"stem":"-3 的相反数是（　）","type":"choice"},{"analysis":"(-2)³ = (-2)×(-2)×(-2) = -8。","answer":"A","difficulty":2,"id":"num-02","knowledge":["有理数"],"options":["-8","8","-6","6"],"stem":"计算 (-2)³ 的结果是（　）","type":"choice"},{"answer":"±5","difficulty":1,"id":"num-03","knowledge":["有理数"],"stem":"绝对值等于 5 的数是 ______。","type":"fill"},{"analysis":"点 B 在 A 的右侧时为 -2.5+4=1.5，在左侧时为 -2.5-4=-6.5。","answer":"1.5 或 -6.5","difficulty":3,"id":"num-04","knowledge":["有理数"],"stem":"数轴上点 A 表示 -2.5，点 B 与点 A 的距离为 4 个单位长度，则点 B 表示的数是 ______。","type":"fill"},{"analysis":"0 的平方是 0，不是正数。","answer":"×","difficulty":2,"id":"num-05","knowledge":["有理数"],"stem":"任何有理数的平方都是正数。（　）","type":"judge"},{"analysis":"-1 - (1/6)×(2-9) = -1 - (1/6)×(-7) = -1 + 7/6 = 1/6。","answer":"1/6","difficulty":3,"id":"num-06","knowledge":["有理数"],"stem":"计算：-1⁴ - (1 - 0.5) × 1/3 × [2 - (-3)²]。","type":"solve"},{"analysis":"次数为各字母指数之和：2+1=3。","answer":"B","difficulty":1,"id":"poly-01","knowledge":["整式"],"options":["2","3","4","5"],"stem":"单项式 -3x²y 的次数是（　）","type":"choice"},{"analysis":"同类项要求相同字母的指数相同，故 m=2，n=3，m+n=5。","answer":"C","difficulty":3,"id":"poly-02","knowledge":["整式"],"options":["3","4","5","6"],"stem":"若 2xᵐy³ 与 -x²yⁿ 是同类项，则 m + n 的值是（　）","type":"choice"},{"answer":"a + b","difficulty":2,"id":"poly-03","knowledge":["整式"],"stem":"化简：3a - (2a - b) = ______。","type":"fill"},{"analysis":"x=2 时 ax³+bx=4；该部分是 x 的奇次式，x=-2 时为 -4，故式值为 -4+1=-3。","answer":"-3","difficulty":4,"id":"poly-04","knowledge":["整式"],"stem":"已知当 x = 2 时，ax³ + bx + 1 的值为 5，则当 x = -2 时，该式的值为 ______。","type":"fill"},{"answer":"√","difficulty":1,"id":"poly-05","knowledge":["整式"],"stem":"3x + 5 是一个多项式。（　）","type":"judge"},{"analysis":"合并同类项得 -5x²y+5xy；代入 x=-1，y=2：-5×1×2 + 5×(-1)×2 = -10 - 10 = -20。","answer":"化简得 -5x²y + 5xy，值为 -20","difficulty":4,"id":"poly-06","knowledge":["整式"],"stem":"先化简，再求值：2(x²y + xy) - 3(x²y - xy) - 4x²y，其中 x = -1，y = 2。","type":"solve"},{"answer":"B","difficulty":1,"id":"eq1-01","knowledge":["一元一次方程"],"options":["x = 1","x = 2","x = -2","x = 4"],"stem":"方程 2x - 4 = 0 的解是（　）","type":"choice"},{"analysis":"利润 = 售价 - 进价，利润 = 进价 × 利润率。","answer":"A","difficulty":3,"id":"eq1-02","knowledge":["一元一次方程"],"options":["x - 80 = 80 × 20%","x = 80 × 20%","80 - x = 20%","x + 80 = 80 × 20%"],"stem":"某商品进价为 80 元，售价为 x 元，利润率为 20%，可列方程为（　）","type":"choice"},{"answer":"1","difficulty":2,"id":"eq1-03","knowledge":["一元一次方程"],"stem":"若 x = 3 是方程 2x - a = 5 的解，则 a = ______。","type":"fill"},{"analysis":"合作效率为 1/6 + 1/4 = 5/12。","answer":"5/12","difficulty":3,"id":"eq1-04","knowledge":["一元一次方程"],"stem":"一项工作甲单独做 6 天完成，乙单独做 4 天完成，则甲、乙合作每天完成这项工作的 ______。","type":"fill"},{"analysis":"除数不能为 0，等式性质要求除以同一个不为 0 的数。","answer":"×","difficulty":2,"id":"eq1-05","knowledge":["一元一次方程"],"stem":"等式两边同时除以同一个数，等式仍然成立。（　）","type":"judge"},{"analysis":"去分母：2(2x-1) - (5x+1) = 6，去括号得 4x - 2 - 5x - 1 = 6，合并得 -x = 9，x = -9。","answer":"x = -9","difficulty":2,"id":"eq1-06","knowledge":["一元一次方程"],"stem":"解方程：(2x - 1)/3 - (5x + 1)/6 = 1。","type":"solve"},{"answer":"B","difficulty":1,"id":"geo-01","knowledge":["几何图形初步"],"options":["10","11","12","13"],"stem":"正方体的表面展开图共有（　）种","type":"choice"},{"analysis":"90° - 37°18′ = 52°42′。","answer":"A","difficulty":2,"id":"geo-02","knowledge":["几何图形初步"],"options":["52°42′","52°82′","142°42′","142°82′"],"stem":"已知 ∠A = 37°18′，则 ∠A 的余角是（　）","type":"choice"},{"answer":"90","difficulty":2,"id":"geo-03","knowledge":["几何图形初步"],"stem":"时钟在 3 点整时，时针与分针的夹角是 ______ 度。","type":"fill"},{"analysis":"CB = AB/2 = 5，BD = CB - CD = 3。","answer":"3","difficulty":3,"id":"geo-04","knowledge":["几何图形初步"],"stem":"点 C 是线段 AB 的中点，AB = 10，点 D 在线段 CB 上，且 CD = 2，则 BD = ______。","type":"fill"},{"answer":"√","difficulty":2,"id":"geo-05","knowledge":["几何图形初步"],"stem":"两点之间，线段最短。（　）","type":"judge"},{"analysis":"由 AD + DB = 12 且 AD = 2DB 得 DB = 4，AD = 8；AC = 6，故 CD = AD - AC = 2。","answer":"CD = 2","difficulty":3,"id":"geo-06","knowledge":["几何图形初步"],"stem":"已知线段 AB = 12，点 C 是 AB 的中点，点 D 在线段 AB 上，且 AD = 2DB，求 CD 的长。","type":"solve"},{"answer":"C","difficulty":2,"id":"line-01","knowledge":["相交线与平行线"],"options":["相等的角是对顶角","同位角相等","内错角相等，两直线平行","两条直线被第三条直线所截，同旁内角互补"],"stem":"下列说法正确的是（　）","type":"choice"},{"analysis":"方向相同意味着两次拐弯构成内错角相等，故第二次拐角也是 130°。","answer":"A","difficulty":3,"id":"line-02","knowledge":["相交线与平行线"],"options":["130°","50°","40°","100°"],"stem":"一条公路经过两次拐弯后与原来的方向相同，第一次拐的角是 130°，则第二次拐的角是（　）","type":"choice"},{"answer":"40","difficulty":2,"id":"line-03","knowledge":["相交线与平行线"],"stem":"∠1 与 ∠2 是对顶角，∠1 = 40°，则 ∠2 = ______°。","type":"fill"},{"analysis":"过点 P 作 AB 的平行线，由平行线性质得 ∠APC = 30° + 40° = 70°。","answer":"70","difficulty":4,"id":"line-04","knowledge":["相交线与平行线"],"stem":"已知 AB ∥ CD，点 P 在 AB、CD 之间，∠BAP = 30°，∠DCP = 40°，则 ∠APC = ______°。","type":"fill"},{"answer":"√","difficulty":1,"id":"line-05","knowledge":["相交线与平行线"],"stem":"在同一平面内，垂直于同一条直线的两条直线互相平行。（　）","type":"judge"},{"analysis":"过点 E 作 AB 的平行线 EF，则 ∠AEF = ∠BAE = 45°，∠DEF = ∠CDE = 25°，故 ∠AED = 70°。","answer":"70°","difficulty":3,"id":"line-06","knowledge":["相交线与平行线"],"stem":"已知 AB ∥ CD，点 E 是 AB、CD 之间的一点，∠BAE = 45°，∠CDE = 25°，求 ∠AED 的度数，并写出推理过程。","type":"solve"},{"analysis":"0.1010010001… 是无限不循环小数；22/7 是分数，√4 = 2，0.333… 是循环小数，均为有理数。","answer":"A","difficulty":1,"id":"real-01","knowledge":["实数"],"options":["0.1010010001…","22/7","√4","0.333…"],"stem":"下列各数中，无理数是（　）","type":"choice"},{"analysis":"√16 = 4，4 的平方根是 ±2。","answer":"C","difficulty":2,"id":"real-02","knowledge":["实数"],"options":["4","-4","±2","2"],"stem":"√16 的平方根是（　）","type":"choice"},{"answer":"-3","difficulty":2,"id":"real-03","knowledge":["实数"],"stem":"³√(-27) = ______。","type":"fill"},{"analysis":"√5 ≈ 2.236 ＞ 2.2。","answer":"＞","difficulty":3,"id":"real-04","knowledge":["实数"],"stem":"比较大小：√5 ______ 2.2（填“＞”“＜”或“＝”）。","type":"fill"},{"analysis":"如 √4 = 2 是有理数。","answer":"×","difficulty":2,"id":"real-05","knowledge":["实数"],"stem":"带根号的数都是无理数。（　）","type":"judge"},{"analysis":"2a - 1 = 9 得 a = 5；3a + b - 1 = 64 得 b = 50；a + 2b = 105，其平方根为 ±√105。","answer":"±√105","difficulty":4,"id":"real-06","knowledge":["实数"],"stem":"已知 2a - 1 的平方根是 ±3，3a + b - 1 的立方根是 4，求 a + 2b 的平方根。","type":"solve"},{"answer":"B","difficulty":1,"id":"coord-01","knowledge":["平面直角坐标系"],"options":["第一象限","第二象限","第三象限","第四象限"],"stem":"点 P(-3, 5) 在（　）","type":"choice"},{"analysis":"左移横坐标减 4，上移纵坐标加 3：(3-4, -2+3) = (-1, 1)。","answer":"B","difficulty":3,"id":"coord-02","knowledge":["平面直角坐标系"],"options":["(7, 1)","(-1, 1)","(-1, -5)","(7, -5)"],"stem":"点 A(3, -2) 先向左平移 4 个单位长度，再向上平移 3 个单位长度，得到的点的坐标是（　）","type":"choice"},{"analysis":"关于 x 轴对称：a = 2，b = 3，故 a + b = 5。","answer":"5","difficulty":2,"id":"coord-03","knowledge":["平面直角坐标系"],"stem":"点 M(a, -3) 与点 N(2, b) 关于 x 轴对称，则 a + b = ______。","type":"fill"},{"answer":"(-5, -3)","difficulty":4,"id":"coord-04","knowledge":["平面直角坐标系"],"stem":"点 P 到 x 轴的距离为 3，到 y 轴的距离为 5，且点 P 在第三象限，则点 P 的坐标是 ______。","type":"fill"},{"analysis":"横坐标为 0 的点在 y 轴上。","answer":"×","difficulty":2,"id":"coord-05","knowledge":["平面直角坐标系"],"stem":"点 (0, -4) 在 x 轴上。（　）","type":"judge"},{"analysis":"AB ∥ x 轴，AB = 6；C 到 AB 的距离为 3 - (-2) = 5；面积 = 6 × 5 ÷ 2 = 15。","answer":"15","difficulty":3,"id":"coord-06","knowledge":["平面直角坐标系"],"stem":"在平面直角坐标系中，已知 A(-2, 3)，B(4, 3)，C(1, -2)，求三角形 ABC 的面积。","type":"solve"}]